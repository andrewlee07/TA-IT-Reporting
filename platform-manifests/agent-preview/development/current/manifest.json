  "workflows": [
    {
      "id": "wf-booking-triage",
      "key": "booking_triage",
      "name": "Booking Triage",
      "description": "Evaluates new requests, sets status, and routes to the right team.",
      "objectKey": "booking_request",
      "status": "draft",
      "triggers": [
        {
          "id": "trigger-booking-created",
          "type": "record_created",
          "label": "When a booking request is created",
          "config": {
            "objectKey": "booking_request"
          }
        }
      ],
      "nodes": [
        {
          "id": "node-triage-start",
          "type": "condition",
          "label": "Value above threshold?",
          "config": {
            "expression": "total_value >= 5000"
          },
          "position": {
            "x": 60,
            "y": 120
          }
        },
        {
          "id": "node-triage-notify",
          "type": "notification",
          "label": "Notify regional ops",
          "config": {
            "channel": "email"
          },
          "position": {
            "x": 320,
            "y": 120
          }
        }
      ],
      "edges": [
        {
          "id": "edge-triage-1",
          "sourceId": "node-triage-start",
          "targetId": "node-triage-notify",
          "label": "yes"
        }
      ]
    }
  ],
