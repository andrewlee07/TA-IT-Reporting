  "objects": [
    {
      "id": "obj-booking-request",
      "key": "booking_request",
      "label": "Booking Request",
      "pluralLabel": "Booking Requests",
      "description": "Core booking workflow entity used to orchestrate supply coverage.",
      "icon": "calendar",
      "primaryFieldKey": "request_title",
      "allowCreate": true,
      "allowUpdate": true,
      "allowDelete": false,
      "fields": [
        {
          "id": "fld-request-title",
          "key": "request_title",
          "label": "Request Title",
          "type": "text",
          "required": true,
          "unique": true,
          "sensitivity": "internal",
          "placeholder": "Year 4 maternity cover",
          "validations": [
            {
              "id": "val-request-title-required",
              "type": "required",
              "message": "A booking request title is required."
            }
          ]
        },
        {
          "id": "fld-school-name",
          "key": "school_name",
          "label": "School Name",
          "type": "text",
          "required": true,
          "unique": false,
          "sensitivity": "internal",
          "placeholder": "Leeds Central Academy",
          "validations": [
            {
              "id": "val-school-name-required",
              "type": "required",
              "message": "School name is required."
            }
          ]
        },
        {
          "id": "fld-contact-email",
          "key": "contact_email",
          "label": "Contact Email",
          "type": "text",
          "required": true,
          "unique": false,
          "sensitivity": "pii",
          "placeholder": "ops@school.example",
          "validations": [
            {
              "id": "val-contact-email-required",
              "type": "required",
              "message": "Contact email is required."
            },
            {
              "id": "val-contact-email-pattern",
              "type": "regex",
              "message": "Enter a valid email address.",
              "value": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
            }
          ]
        },
        {
          "id": "fld-vacancies",
          "key": "vacancies",
          "label": "Vacancies",
          "type": "number",
          "required": true,
          "unique": false,
          "sensitivity": "internal",
          "defaultValue": 1,
          "validations": [
            {
              "id": "val-vacancies-min",
              "type": "min",
              "message": "Vacancies must be at least 1.",
              "value": 1
            }
          ]
        },
        {
          "id": "fld-daily-rate",
          "key": "daily_rate",
          "label": "Daily Rate",
          "type": "currency",
          "required": true,
          "unique": false,
          "sensitivity": "internal",
          "validations": [
            {
              "id": "val-daily-rate-min",
              "type": "min",
              "message": "Daily rate must be positive.",
              "value": 0
            }
          ]
        },
        {
          "id": "fld-days-requested",
          "key": "days_requested",
          "label": "Days Requested",
          "type": "number",
          "required": true,
          "unique": false,
          "sensitivity": "internal",
          "defaultValue": 5,
          "validations": [
            {
              "id": "val-days-min",
              "type": "min",
              "message": "Days requested must be at least 1.",
              "value": 1
            }
          ]
        },
        {
          "id": "fld-total-value",
          "key": "total_value",
          "label": "Total Value",
          "type": "computed",
          "required": false,
          "unique": false,
          "sensitivity": "internal",
          "validations": [],
          "calculation": {
            "id": "calc-total-value",
            "expression": "daily_rate * days_requested * vacancies",
            "outputType": "currency",
            "description": "Estimated total booking value."
          }
        },
        {
          "id": "fld-status",
          "key": "status",
          "label": "Status",
          "type": "select",
          "required": true,
          "unique": false,
          "sensitivity": "internal",
          "defaultValue": "Open",
          "options": [
            "Open",
            "Review",
            "Matched",
            "Filled"
          ],
          "validations": []
        }
      ],
      "relationships": [],
      "views": [
        {
          "id": "view-booking-default",
          "key": "default",
          "label": "Default View",
          "objectKey": "booking_request",
          "visibleFieldKeys": [
            "request_title",
            "school_name",
            "status",
            "vacancies",
            "total_value"
          ],
          "defaultSortKey": "request_title"
        }
      ]
    },
